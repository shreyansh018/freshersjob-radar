# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. NEVER commit .env.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=local
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:8080

# PostgreSQL (service name 'postgres' is the Docker Compose hostname)
POSTGRES_USER=freshers
POSTGRES_PASSWORD=freshers_password
POSTGRES_DB=freshersjobs
DATABASE_URL=postgresql+asyncpg://freshers:freshers_password@postgres:5432/freshersjobs
DATABASE_SYNC_URL=postgresql+psycopg://freshers:freshers_password@postgres:5432/freshersjobs

# Redis (local Docker). On Vercel use an external Redis URL for REDIS_URL and
# set the Celery transports to Vercel Queues instead.
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Vercel-only: Vercel Queues replaces the Redis broker/result backend, and the
# shared Gemini limiter gives all function instances one rate-limit budget.
# CELERY_BROKER_URL=vercel://
# CELERY_RESULT_BACKEND=vercel-runtime-cache://
# GEMINI_SHARED_RATE_LIMIT=true
# CRON_SECRET=replace-with-a-long-random-string
# COOKIE_SECURE=true
# REGISTRATION_ENABLED=false

# Google Gemini (backend only — never expose to the frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_DESCRIPTION_CHARS=12000
GEMINI_MIN_INTERVAL_SECONDS=13.0
GEMINI_RATE_LIMIT_RETRIES=3

# Ingestion limits
INGEST_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
MAX_JOBS_PER_SOURCE=1000

# Freshness rules
STALE_AFTER_MISSES=3
EXPIRE_AFTER_DAYS_UNCONFIRMED=14
NEW_JOB_DAYS=3
